# ============================================================
# AI Social Media Agent — Environment Variables Template
# Copy file này thành .env và điền các giá trị thực
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# --- Groq ---
GROQ_API_KEY=gsk_...

# --- Facebook / Meta ---
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Token Encryption (Fernet key, generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
ENCRYPTION_KEY=

# --- URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
